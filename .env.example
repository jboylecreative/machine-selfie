# Required: your Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model to use for the artist (see `npm run server -- --list-models`)
GEMINI_MODEL=gemini-3.1-pro-preview
# MINIMAL | LOW | MEDIUM | HIGH  (Gemini 3 thinking level)
THINKING_LEVEL=HIGH
TEMPERATURE=1.0

# Safety limits per artwork
MAX_TURNS=150
# The artist can't declare a work finished before this many turns
MIN_TURNS=15
MAX_TOOL_CALLS=1500

# Pressing Begin starts a run of WORKS_PER_RUN works; then the studio idles and the button
# offers to continue. Closing the browser tab that pressed it stops the run early.
WORKS_PER_RUN=10
# Seconds of rest between works within a run (0 = no rest)
REST_SECONDS=20

# true = show the artist its earlier works (titles, statements, thumbnails) at the start of each session.
# false = every work starts fresh, with no knowledge that any other work exists.
REMEMBER_PAST_WORKS=false

# Optional site password. When set, visitors must enter it to watch or press Begin.
# (Leave empty locally for no login screen.)
SITE_PASSWORD=

# Where the archive of works is stored. Default: ./data, or the attached volume on Railway.
# DATA_DIR=/data

PORT=8787
