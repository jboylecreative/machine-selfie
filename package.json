{
  "name": "machine-selfie",
  "version": "1.0.0",
  "description": "An AI painting its own self-portraits, live in the browser",
  "scripts": {
    "dev": "concurrently -k -n server,client -c magenta,cyan \"tsx watch src/server/index.ts\" \"vite\"",
    "server": "tsx src/server/index.ts",
    "build": "vite build",
    "start": "tsx src/server/index.ts --prod",
    "typecheck": "tsc --noEmit",
    "fonts": "tsx scripts/fetch-fonts.ts"
  },
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@google/genai": "^2.28.0",
    "@napi-rs/canvas": "^1.0.11",
    "dotenv": "^18.0.7",
    "tsx": "^4.23.15",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "concurrently": "^10.0.6",
    "playwright-core": "^1.64.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "private": true,
  "engines": {
    "node": "24.x"
  }
}
